<rml>
<body data-model="point_align_panel">
<div id="content-wrap"><div id="content">

  <!-- Instructions -->
  <span class="section-label" style="color: #4A90D9;">3-Point Alignment</span>
  <span class="text-muted">Step 1: Pick 3 points on the REFERENCE 3DGS.</span><br/>
  <span class="text-muted">Step 2: Pick 3 points on the TARGET 3DGS.</span><br/>
  <span class="text-muted">Step 3: Calculate &amp; apply to the Edit panel.</span>

  <div class="separator"></div>

  <!-- ── ADJUST POINTS ── -->
  <span class="section-label" style="color: #ffcc44;">─── Adjust Points ───</span>

  <!-- Step size -->
  <div class="setting-row">
    <span class="prop-label">Step:</span>
    <button class="{{step__001_active ? 'btn btn--primary' : 'btn'}}"
            data-event-click="step__001" style="width:44px;">.001</button>
    <button class="{{step__01_active  ? 'btn btn--primary' : 'btn'}}"
            data-event-click="step__01"  style="width:44px;">.01</button>
    <button class="{{step__1_active   ? 'btn btn--primary' : 'btn'}}"
            data-event-click="step__1"   style="width:44px;">.1</button>
    <button class="{{step_1_0_active  ? 'btn btn--primary' : 'btn'}}"
            data-event-click="step_1_0"  style="width:44px;">1.0</button>
  </div>

  <!-- ── Reference point nudge rows ── -->
  <span class="section-label" style="color: #20c8ff; font-size:0.9em;">Reference</span>

  <!-- Ref Pt 1 -->
  <div class="btn-row" data-if="ref_pt1_has_pos">
    <span style="color:#20c8ff; font-weight:bold; min-width:28px;">R1:</span>
    <span style="color:#ff5555;">X</span>
    <button class="btn" data-event-click="ref_pt1_x_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="ref_pt1_x_plus"  style="width:28px;">+</button>
    <span style="color:#55ff55;">Y</span>
    <button class="btn" data-event-click="ref_pt1_y_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="ref_pt1_y_plus"  style="width:28px;">+</button>
    <span style="color:#5588ff;">Z</span>
    <button class="btn" data-event-click="ref_pt1_z_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="ref_pt1_z_plus"  style="width:28px;">+</button>
  </div>

  <!-- Ref Pt 2 -->
  <div class="btn-row" data-if="ref_pt2_has_pos">
    <span style="color:#20c8ff; font-weight:bold; min-width:28px;">R2:</span>
    <span style="color:#ff5555;">X</span>
    <button class="btn" data-event-click="ref_pt2_x_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="ref_pt2_x_plus"  style="width:28px;">+</button>
    <span style="color:#55ff55;">Y</span>
    <button class="btn" data-event-click="ref_pt2_y_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="ref_pt2_y_plus"  style="width:28px;">+</button>
    <span style="color:#5588ff;">Z</span>
    <button class="btn" data-event-click="ref_pt2_z_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="ref_pt2_z_plus"  style="width:28px;">+</button>
  </div>

  <!-- Ref Pt 3 -->
  <div class="btn-row" data-if="ref_pt3_has_pos">
    <span style="color:#20c8ff; font-weight:bold; min-width:28px;">R3:</span>
    <span style="color:#ff5555;">X</span>
    <button class="btn" data-event-click="ref_pt3_x_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="ref_pt3_x_plus"  style="width:28px;">+</button>
    <span style="color:#55ff55;">Y</span>
    <button class="btn" data-event-click="ref_pt3_y_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="ref_pt3_y_plus"  style="width:28px;">+</button>
    <span style="color:#5588ff;">Z</span>
    <button class="btn" data-event-click="ref_pt3_z_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="ref_pt3_z_plus"  style="width:28px;">+</button>
  </div>

  <!-- ── Target point nudge rows ── -->
  <span class="section-label" style="color: #ffcc22; font-size:0.9em;">Target</span>

  <!-- Tgt Pt 1 -->
  <div class="btn-row" data-if="tba_pt1_has_pos">
    <span style="color:#ffcc22; font-weight:bold; min-width:28px;">T1:</span>
    <span style="color:#ff5555;">X</span>
    <button class="btn" data-event-click="tba_pt1_x_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="tba_pt1_x_plus"  style="width:28px;">+</button>
    <span style="color:#55ff55;">Y</span>
    <button class="btn" data-event-click="tba_pt1_y_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="tba_pt1_y_plus"  style="width:28px;">+</button>
    <span style="color:#5588ff;">Z</span>
    <button class="btn" data-event-click="tba_pt1_z_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="tba_pt1_z_plus"  style="width:28px;">+</button>
  </div>

  <!-- Tgt Pt 2 -->
  <div class="btn-row" data-if="tba_pt2_has_pos">
    <span style="color:#ffcc22; font-weight:bold; min-width:28px;">T2:</span>
    <span style="color:#ff5555;">X</span>
    <button class="btn" data-event-click="tba_pt2_x_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="tba_pt2_x_plus"  style="width:28px;">+</button>
    <span style="color:#55ff55;">Y</span>
    <button class="btn" data-event-click="tba_pt2_y_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="tba_pt2_y_plus"  style="width:28px;">+</button>
    <span style="color:#5588ff;">Z</span>
    <button class="btn" data-event-click="tba_pt2_z_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="tba_pt2_z_plus"  style="width:28px;">+</button>
  </div>

  <!-- Tgt Pt 3 -->
  <div class="btn-row" data-if="tba_pt3_has_pos">
    <span style="color:#ffcc22; font-weight:bold; min-width:28px;">T3:</span>
    <span style="color:#ff5555;">X</span>
    <button class="btn" data-event-click="tba_pt3_x_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="tba_pt3_x_plus"  style="width:28px;">+</button>
    <span style="color:#55ff55;">Y</span>
    <button class="btn" data-event-click="tba_pt3_y_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="tba_pt3_y_plus"  style="width:28px;">+</button>
    <span style="color:#5588ff;">Z</span>
    <button class="btn" data-event-click="tba_pt3_z_minus" style="width:28px;">-</button>
    <button class="btn" data-event-click="tba_pt3_z_plus"  style="width:28px;">+</button>
  </div>

  <div class="separator"></div>

  <!-- ── REFERENCE POINTS ── -->
  <span class="section-label" style="color: #20c8ff;">Reference Points</span>

  <div class="btn-row">
    <button class="btn" data-event-click="ref_pick1"
            title="Click to start picking Reference Point 1 on the model">{{ref_pt1_label}}</button>
  </div>
  <div class="btn-row">
    <button class="btn" data-event-click="ref_pick2"
            title="Click to start picking Reference Point 2 on the model">{{ref_pt2_label}}</button>
  </div>
  <div class="btn-row">
    <button class="btn" data-event-click="ref_pick3"
            title="Click to start picking Reference Point 3 on the model">{{ref_pt3_label}}</button>
  </div>

  <div class="btn-row">
    <button class="btn" data-event-click="save_ref"
            title="Save reference points to align_reference.json">Save Ref Points</button>
    <button class="btn" data-event-click="load_ref"
            title="Load reference points from align_reference.json">Load Ref Points</button>
    <button class="btn" data-event-click="clear_ref"
            title="Clear all reference points">Clear</button>
  </div>

  <div class="separator"></div>

  <!-- ── TARGET POINTS ── -->
  <span class="section-label" style="color: #ffcc22;">Target Points  (To Be Aligned)</span>

  <div class="btn-row">
    <button class="btn" data-event-click="tba_pick1"
            title="Click to start picking Target Point 1 on the model">{{tba_pt1_label}}</button>
  </div>
  <div class="btn-row">
    <button class="btn" data-event-click="tba_pick2"
            title="Click to start picking Target Point 2 on the model">{{tba_pt2_label}}</button>
  </div>
  <div class="btn-row">
    <button class="btn" data-event-click="tba_pick3"
            title="Click to start picking Target Point 3 on the model">{{tba_pt3_label}}</button>
  </div>

  <div class="btn-row">
    <button class="btn" data-event-click="save_tba"
            title="Save target points to align_target.json">Save Target Points</button>
    <button class="btn" data-event-click="load_tba"
            title="Load target points from align_target.json">Load Target Points</button>
    <button class="btn" data-event-click="clear_tba"
            title="Clear all target points">Clear</button>
  </div>

  <div class="separator"></div>

  <!-- ── CALCULATE ── -->
  <span class="section-label" style="color: #4A90D9;">Calculate Transform</span>
  <span class="text-muted">Solves scale, rotation and translation that maps Target → Reference.</span>

  <div class="btn-row">
    <button class="btn btn--full" data-event-click="do_calculate"
            title="Calculate the similarity transform from the 6 picked points">Calculate Transform</button>
  </div>

  <!-- Result display -->
  <div data-if="has_result">
    <div class="separator"></div>
    <span class="section-label" style="color: #4A90D9;">Result</span>

    <div class="setting-row">
      <span class="prop-label" style="color:#aaa;">Tx</span>
      <span style="font-weight:bold; color:#e0e0e0;">{{result_tx}}</span>
      <span class="prop-label" style="color:#aaa; margin-left:1em;">Ty</span>
      <span style="font-weight:bold; color:#e0e0e0;">{{result_ty}}</span>
      <span class="prop-label" style="color:#aaa; margin-left:1em;">Tz</span>
      <span style="font-weight:bold; color:#e0e0e0;">{{result_tz}}</span>
    </div>
    <div class="setting-row">
      <span class="prop-label" style="color:#aaa;">Rx</span>
      <span style="font-weight:bold; color:#ff6666;">{{result_rx}}</span>
      <span class="prop-label" style="color:#aaa; margin-left:1em;">Ry</span>
      <span style="font-weight:bold; color:#66ff88;">{{result_ry}}</span>
      <span class="prop-label" style="color:#aaa; margin-left:1em;">Rz</span>
      <span style="font-weight:bold; color:#6699ff;">{{result_rz}}</span>
    </div>
    <div class="setting-row">
      <span class="prop-label" style="color:#aaa;">Scale</span>
      <span style="font-weight:bold; color:#e0e0e0;">{{result_sx}}</span>
    </div>

    <div class="btn-row">
      <button class="btn btn--full" data-event-click="do_prefill"
              title="Write the solved transform into settings.json — then click Reload Settings on the Edit tab">Apply to Edit Panel</button>
    </div>
  </div>

  <div class="separator"></div>

  <!-- Status -->
  <span class="{{status_class}}">{{status_text}}</span>

</div></div>
</body>
</rml>
